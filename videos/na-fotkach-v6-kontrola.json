  "isolated_voice_asr": [
    {
      "start": 0.0,
      "end": 2.76,
      "text": " Ty si kripl, to na Tinderu nebylo vidět."
    },
    {
      "start": 2.82,
      "end": 4.68,
      "text": " No jo, a ještě k tomu švorc."
    },
    {
      "start": 5.62,
      "end": 8.24,
      "text": " Hned se vrátím, jdu si odskočit."
    },
    {
      "start": 12.51,
      "end": 17.33,
      "text": " Slečna říkala, že platíte vy i za ty tři koktejly, co si dala, než jste přijel."
    },
    {
      "start": 18.15,
      "end": 19.43,
      "text": " Já se jí nedivím."
    },
    {
      "start": 20.31,
      "end": 23.53,
      "text": " Osud se na mě vyřádil, ale já s ním vyjebu."
    },
    {
      "start": 30.71,
      "end": 33.13,
      "text": " Tohle bych se stříhal líp i se zavřenýma očima."
    },
    {
      "start": 35.78,
      "end": 37.88,
      "text": " Sice je to mrzák, ale je to někdo."
    },
    {
      "start": 38.52,
      "end": 40.36,
      "text": " Díky zlato, to potěší."
    },
    {
      "start": 41.24,
      "end": 43.42,
      "text": " Holky, tohle je můj sugar cripple."
    },
    {
      "start": 43.96,
      "end": 45.78,
      "text": " To si mám dát na vyzitky?"
    },
    {
      "start": 51.11,
      "end": 52.95,
      "text": " Hned se vrátím, dusi odskočit."
    },
    {
      "start": 54.89,
      "end": 56.37,
      "text": " Ahoj, seš to ty?"
    },
    {
      "start": 57.07,
      "end": 59.13,
      "text": " Nebyjt cripple, tak ti ani nepoznám."
    },
    {
      "start": 59.85,
      "end": 61.57,
      "text": " Ty to potřebujš zaplatit, Veť."
    },
    {
      "start": 65.48,
      "end": 69.8,
      "text": " Stav se někdy na steak."
    }
  ],
