  "isolated_voice_asr": [
    {
      "start": 0.56,
      "end": 2.92,
      "text": " Ty si kripl, to na Tinderu nebylo vidět."
    },
    {
      "start": 3.0,
      "end": 4.84,
      "text": " No jo, a ještě k tomu švorc."
    },
    {
      "start": 5.36,
      "end": 5.72,
      "text": " Ha ha ha."
    },
    {
      "start": 6.2,
      "end": 8.54,
      "text": " Hned se vrátím, jdu si odskočit."
    },
    {
      "start": 13.67,
      "end": 18.47,
      "text": " Slečna říkala, že platíte vy i za ty tři koktejly, co si dala, než jste přijel."
    },
    {
      "start": 19.33,
      "end": 20.53,
      "text": " Já se jí nedivím."
    },
    {
      "start": 21.41,
      "end": 22.95,
      "text": " Osud se na mě vyřádil."
    },
    {
      "start": 23.39,
      "end": 24.67,
      "text": " Ale já s ním vyjebu."
    },
    {
      "start": 34.16,
      "end": 36.62,
      "text": " Tohle bych se stříhal líp i se zavřenýma očima."
    },
    {
      "start": 40.64,
      "end": 42.78,
      "text": " Sice je to mrzák, ale je to někdo."
    },
    {
      "start": 43.5,
      "end": 45.26,
      "text": " Díky zlato, to potěší."
    },
    {
      "start": 46.08,
      "end": 48.34,
      "text": " Holky, tohle je můj sugar cripple!"
    },
    {
      "start": 48.82,
      "end": 50.7,
      "text": " To si mám dát na vyzitky?"
    },
    {
      "start": 57.41,
      "end": 59.29,
      "text": " Hned se vrátím, dusi odskočit!"
    },
    {
      "start": 61.29,
      "end": 62.79,
      "text": " Ahoj, seš to ty?"
    },
    {
      "start": 63.77,
      "end": 65.6,
      "text": " Nebýt cripple, tak ti ani nepoznám."
    },
    {
      "start": 67.05,
      "end": 68.87,
      "text": " Tyto potřebujš zaplatit, Vyť."
    },
    {
      "start": 72.8,
      "end": 78.94,
      "text": " Stav se někdy na steak."
    }
  ],
