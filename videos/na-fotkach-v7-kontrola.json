  "isolated_voice_asr": [
    {
      "start": 0.0,
      "end": 2.76,
      "text": " Ty si kripl, to na Tinderu nebylo vidět."
    },
    {
      "start": 2.82,
      "end": 4.68,
      "text": " No jo, a ještě k tomu švorc."
    },
    {
      "start": 5.62,
      "end": 8.24,
      "text": " Hned se vrátím, jdu si odskočit."
    },
    {
      "start": 12.51,
      "end": 17.33,
      "text": " Slečna říkala, že platíte vy i za ty tři koktejly, co si dala, než jste přijel."
    },
    {
      "start": 18.15,
      "end": 19.43,
      "text": " Já se jí nedivím."
    },
    {
      "start": 20.31,
      "end": 23.53,
      "text": " Osud se na mě vyřádil, ale já s ním vyjebu."
    },
    {
      "start": 30.71,
      "end": 33.13,
      "text": " Tohle bych se stříhal líp i se zavřenýma očima."
    },
    {
      "start": 35.78,
      "end": 37.88,
      "text": " Sice je to mrzák, ale je to někdo."
    },
    {
      "start": 38.52,
      "end": 40.36,
      "text": " Díky zlato, to potěší."
    },
    {
      "start": 41.2,
      "end": 43.44,
      "text": " Holky, tohle je můj sugar cripple!"
    },
    {
      "start": 48.4,
      "end": 50.5,
      "text": " Hned se vrátím, dusi odskočit!"
    },
    {
      "start": 52.4,
      "end": 53.9,
      "text": " Ahoj, seš to ty?"
    },
    {
      "start": 54.54,
      "end": 56.7,
      "text": " Nebyjt cripple, tak tě ani nepoznám."
    },
    {
      "start": 57.4,
      "end": 59.12,
      "text": " Ty to potřebuješ zaplatit, víď?"
    },
    {
      "start": 63.03,
      "end": 63.91,
      "text": " Stav se někdy..."
    },
    {
      "start": 66.79,
      "end": 67.31,
      "text": " ...na steak."
    }
  ],
